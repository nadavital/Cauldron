rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared Recipes
    match /shared_recipes/{shareId} {
      // Public pages and import APIs are rendered by validated Cloud Functions.
      // Raw documents also contain a non-reversible management capability hash.
      allow read: if false;
      allow create: if false; // Writes must go through validated Cloud Functions
      allow update: if false;
      allow delete: if false;
    }

    // Shared Profiles
    match /shared_profiles/{shareId} {
      // Public profile previews and imports are served through Cloud Functions,
      // which omit the management hash.
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Shared Collections
    match /shared_collections/{shareId} {
      // Collections use the same validated API/preview boundary as recipes.
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
