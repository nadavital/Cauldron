{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ],
            "predeploy": [
                "npm --prefix \"$RESOURCE_DIR\" run preflight:production"
            ]
        }
    ],
    "hosting": {
        "public": "public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/sitemap.xml",
                "function": "previewSitemap"
            },
            {
                "source": "/",
                "function": "previewHome"
            },
            {
                "source": "/recipe/*/social-card.png",
                "function": "previewRecipeImage"
            },
            {
                "source": "/recipe/**",
                "function": "previewRecipe"
            },
            {
                "source": "/u/*/*",
                "function": "previewRecipe"
            },
            {
                "source": "/u/*",
                "function": "previewProfile"
            },
            {
                "source": "/profile/**",
                "function": "previewProfile"
            },
            {
                "source": "/collection/**",
                "function": "previewCollection"
            },
            {
                "source": "/invite",
                "function": "previewInvite"
            },
            {
                "source": "/invite/**",
                "function": "previewInvite"
            },
            {
                "source": "/api/**",
                "function": "api"
            }
        ],
        "headers": [
            {
                "source": "/@(icon-small-light.svg|icon-small-dark.svg|icon-light.svg|icon-dark.svg|favicon.svg|favicon.ico|apple-touch-icon.png|social-card.png)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=86400"
                    }
                ]
            },
            {
                "source": "/.well-known/apple-app-site-association",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ]
            }
        ]
    },
    "emulators": {
        "firestore": {
            "port": 8088
        },
        "singleProjectMode": true
    }
}
