{
    "name": "functions",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test:sanitizer": "npm run build && node --test --test-force-exit test/sharePreviewSanitizer.test.mjs",
        "test:monitor": "node --test test/hostedSharingMonitor.test.mjs",
        "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-cauldron-rules --only firestore \"node --test --test-force-exit test/firestoreRules.test.mjs\"",
        "verify:java": "node tools/verifyJava21.mjs",
        "test": "npm run test:sanitizer && npm run test:monitor && npm run verify:java && npm run test:rules",
        "monitor:hosted": "node tools/monitorHostedSharing.mjs",
        "audit:production": "npm audit --omit=dev --audit-level=high",
        "verify:cloudkit": "node tools/verifyCloudKitPreflight.mjs",
        "scrub:legacy-web-snapshots": "node tools/scrubLegacyRecipeSnapshots.mjs",
        "preflight:production": "npm test && npm run audit:production && npm run verify:cloudkit",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "firebase-admin": "^14.2.0",
        "firebase-functions": "^7.3.2"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.1",
        "firebase": "^12.17.1",
        "firebase-tools": "^15.26.0",
        "typescript": "^5.0.0"
    },
    "private": true
}
