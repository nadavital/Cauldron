{
    "name": "functions",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test:sanitizer": "npm run build && node --test --test-force-exit test/sharePreviewSanitizer.test.mjs",
        "verify:cloudkit": "node tools/verifyCloudKitPreflight.mjs",
        "scrub:legacy-web-snapshots": "node tools/scrubLegacyRecipeSnapshots.mjs",
        "preflight:production": "npm run test:sanitizer && npm run verify:cloudkit",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "firebase-admin": "^11.8.0",
        "firebase-functions": "^4.3.1"
    },
    "devDependencies": {
        "typescript": "^5.0.0",
        "firebase-functions-test": "^3.1.0"
    },
    "private": true
}
